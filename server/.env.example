# Copy this template to server/.env locally, never commit real credentials.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/iem_admission_poc
JWT_SECRET=replace-with-a-long-random-secret
SEED_DEMO_OFFICER=false
DEMO_OFFICER_EMAIL=officer@example.test
DEMO_OFFICER_PASSWORD=replace-with-a-strong-password
